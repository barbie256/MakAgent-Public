# PostgreSQL connection used by the application and Alembic.
DATABASE_URL=postgresql+psycopg://makagent:change-me@localhost:5432/makagent

# Generate a long, random value and keep it outside source control.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

GEMINI_API_KEY=your_gemini_api_key_here

# Provision separately with scripts/provision_embedding_model.py.
# Relative paths resolve against the backend directory, not the process CWD.
RAG_EMBEDDING_MODEL_PATH=./models/all-MiniLM-L6-v2
